# Neo4j connection
CODE_SPIDER_NEO4J_URI=bolt://localhost:7687
CODE_SPIDER_NEO4J_USER=neo4j
CODE_SPIDER_NEO4J_PASSWORD=codespider-dev-password
CODE_SPIDER_NEO4J_DATABASE=neo4j

# Manifest + checkout
CODE_SPIDER_MANIFEST_PATH=./workspaces.yaml
CODE_SPIDER_CHECKOUT_ROOT=./checkouts

# Logging
CODE_SPIDER_LOG_LEVEL=INFO
CODE_SPIDER_LOG_JSON=0

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Default: local sentence-transformers/all-MiniLM-L6-v2 (384-dim, no API key).
# Switch to an external provider via LiteLLM by setting CODE_SPIDER_EMBED_PROVIDER
# to "litellm" and supplying CODE_SPIDER_EMBED_MODEL + dim.
#
# CODE_SPIDER_EMBED_PROVIDER=sentence-transformers
# CODE_SPIDER_EMBED_DIM=384
# CODE_SPIDER_EMBED_BATCH_SIZE=64

# --- Example: Voyage AI (recommended for code retrieval) ---
# voyage-code-3 is purpose-built for source code, top of code-retrieval
# benchmarks. After switching, run `code-spider migrate` to recreate the
# vector index at the new dimension.
# CODE_SPIDER_EMBED_PROVIDER=litellm
# CODE_SPIDER_EMBED_MODEL=voyage/voyage-code-3
# CODE_SPIDER_EMBED_DIM=1024
# VOYAGE_API_KEY=...

# --- Example: OpenAI text-embedding-3-small ---
# CODE_SPIDER_EMBED_PROVIDER=litellm
# CODE_SPIDER_EMBED_MODEL=openai/text-embedding-3-small
# CODE_SPIDER_EMBED_DIM=1536
# OPENAI_API_KEY=...

# --- Example: OpenRouter (OpenAI-compatible gateway; embeddings must be supported by the chosen route) ---
# CODE_SPIDER_EMBED_PROVIDER=litellm
# CODE_SPIDER_EMBED_MODEL=openrouter/openai/text-embedding-3-small
# CODE_SPIDER_EMBED_DIM=1536
# CODE_SPIDER_EMBED_API_BASE=https://openrouter.ai/api/v1
# CODE_SPIDER_EMBED_API_KEY=sk-or-...

# Optional LiteLLM tuning:
# CODE_SPIDER_EMBED_TIMEOUT_S=30
# CODE_SPIDER_EMBED_MAX_RETRIES=3
